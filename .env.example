# Copy to .env (git-ignored) and fill in. These values are compiled into the app and are
# readable by anyone who installs it: only put PUBLISHABLE values here, never a secret key.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_). Safe for clients because
# Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Links shown on the sign-in screen. When empty, the text is shown without a link.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
